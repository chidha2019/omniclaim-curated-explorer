        "additionalProperties": false,
        "type": "object",
        "required": [
          "spans"
        ],
        "title": "BrowserBatch"
      },
      "BrowserSpan": {
        "properties": {
          "name": {
            "type": "string",
            "enum": [
              "GET /api/v1/customers",
              "GET /api/v1/policies",
              "GET /api/v1/claims",
              "GET /api/v1/data-health"
            ],
            "title": "Name"
          },
          "trace_id": {
            "type": "string",
            "pattern": "^[0-9a-f]{32}$",
            "title": "Trace Id"
          },
          "span_id": {
            "type": "string",
            "pattern": "^[0-9a-f]{16}$",
            "title": "Span Id"
          },
          "start_ns": {
            "type": "integer",
            "exclusiveMinimum": 0.0,
            "title": "Start Ns"
          },
          "duration_ns": {
            "type": "integer",
            "maximum": 120000000000.0,
            "minimum": 0.0,
            "title": "Duration Ns"
          },
          "error": {
            "type": "boolean",
            "title": "Error"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "name",
          "trace_id",
